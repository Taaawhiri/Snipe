{
  "name": "snipe",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // Un deploy da Git non cancella le variabili impostate a mano dalla dashboard.
  "keep_vars": true,
  "assets": { "directory": "./public" },
  // Workers AI: riconoscimento delle carte dalle foto (scanner).
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "SCANNER", "class_name": "Scanner" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Scanner"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],
  // Ogni 10 minuti rimette in moto lo scan se per qualsiasi motivo si fosse fermato (gli alarm bastano di norma).
  "triggers": { "crons": ["*/10 * * * *"] }
}
