{
  "name": "snipe",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "SCANNER", "class_name": "Scanner" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scanner"] }],
  // Ogni minuto rimette in moto lo scan se per qualsiasi motivo si fosse fermato.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Cambia con la tua email: serve ai servizi push (Apple li rifiuta se non è valida).
    "VAPID_SUBJECT": "mailto:CHANGE_ME@example.com"
  }
}
